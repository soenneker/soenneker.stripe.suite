<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Bundle and register Soenneker's Stripe customer, payment, invoice-item, and subscription libraries.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Stripe.Suite</AssemblyName>
        <PackageId>Soenneker.Stripe.Suite</PackageId>
        <PackageTags>stripe suite payment processing stripesuite util csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2024-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.stripe.suite</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.stripe.suite</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Stripe.Client" Version="11.0.1556" />
        <PackageReference Include="Soenneker.Stripe.Customers" Version="11.0.1254" />
        <PackageReference Include="Soenneker.Stripe.InvoiceItems" Version="11.0.346" />
        <PackageReference Include="Soenneker.Stripe.PaymentIntents" Version="11.0.1311" />
        <PackageReference Include="Soenneker.Stripe.PaymentMethods" Version="11.0.1294" />
        <PackageReference Include="Soenneker.Stripe.SetupIntents" Version="11.0.513" />
        <PackageReference Include="Soenneker.Stripe.SubscriptionItems" Version="11.0.344" />
        <PackageReference Include="Soenneker.Stripe.Subscriptions" Version="11.0.1442" />
    </ItemGroup>
</Project>
